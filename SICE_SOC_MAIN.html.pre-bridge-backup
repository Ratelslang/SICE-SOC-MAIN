/* ================= NOC HEALTH MONITOR ================= */
var NOC_CONFIG = {
  serverUrl : "http://localhost:8743/health", // falls back to "/" if /health absent
  syncUrl   : "http://127.0.0.1:8384/",       // Syncthing GUI port — reachability probe
  feedUrl   : "http://localhost:8743/proxy?url=https://feeds.capi24.com/v1/Search/articles/news24/TopStories/rss",  // FIXED 06-Jul-2026: old path (missing /Search/articles) 404'd upstream
  intervalMs: 60000,                          // 60s cycle
  timeoutMs : 5000
};

function nocFetchWithTimeout(url, opts, timeoutOverrideMs){
  opts = opts || {};
  var ctrl = new AbortController();
  var timeoutMs = timeoutOverrideMs || NOC_CONFIG.timeoutMs;
  var t = setTimeout(function(){ ctrl.abort(); }, timeoutMs);
  opts.signal = ctrl.signal;
  opts.cache = "no-store";
  return fetch(url, opts).finally(function(){ clearTimeout(t); });
}

function nocSetTile(dotId, detailId, state, detail){
  var dot = document.getElementById(dotId);
  var det = document.getElementById(detailId);
  if(!dot || !det) return;
  dot.className = "noc-dot " + state; // up | warn | down | ""
  det.textContent = detail || "—";
}

/* SERVER — same-origin check against sice_server.py */
function nocCheckServer(){
  return nocFetchWithTimeout(NOC_CONFIG.serverUrl)
    .then(function(r){
      if(r.ok){ nocSetTile("nocServerDot","nocServerDetail","up","8743 online"); return; }
      /* /health missing but server answered → try root */
      return nocFetchWithTimeout("http://localhost:8743/").then(function(r2){
        if(r2.ok){ nocSetTile("nocServerDot","nocServerDetail","warn","up, no /health"); }
        else { nocSetTile("nocServerDot","nocServerDetail","down","HTTP " + r2.status); }
      });
    })
    .catch(function(){
      nocSetTile("nocServerDot","nocServerDetail","down","unreachable");
    });
}

/* SYNC — Syncthing reachability probe (no-cors: opaque response = port alive) */
function nocCheckSync(){
  return nocFetchWithTimeout(NOC_CONFIG.syncUrl, { mode:"no-cors" })
    .then(function(){ nocSetTile("nocSyncDot","nocSyncDetail","up","8384 alive"); })
    .catch(function(){ nocSetTile("nocSyncDot","nocSyncDetail","down","daemon down"); });
}

/* FEEDS — RSS relay responding with payload
   NOTE: sice_server.py allows up to 10s for the outbound RSS fetch, so this
   check must wait at least that long, otherwise a healthy-but-slow feed
   gets reported as "down" purely from a client-side abort. */
function nocCheckFeeds(){
  return nocFetchWithTimeout(NOC_CONFIG.feedUrl, {}, 12000)
    .then(function(r){
      if(r.ok){ nocSetTile("nocFeedsDot","nocFeedsDetail","up","relay OK"); }
      else if(r.status === 400 || r.status === 404){
        /* relay alive but path/params off — infra up, config check needed */
        nocSetTile("nocFeedsDot","nocFeedsDetail","warn","relay up, HTTP " + r.status);
      } else {
        nocSetTile("nocFeedsDot","nocFeedsDetail","down","HTTP " + r.status);
      }
    })
    .catch(function(){ nocSetTile("nocFeedsDot","nocFeedsDetail","down","no relay"); });
}

function nocRunChecks(){
  Promise.allSettled([nocCheckServer(), nocCheckSync(), nocCheckFeeds()])
    .then(function(){
      var now = new Date();
      var stamp = now.toLocaleTimeString("en-ZA", { hour12:false }) + " SAST";
      var el = document.getElementById("nocLastCheck");
      if(el) el.textContent = "Last check: " + stamp;
      try{
        localStorage.setItem("SICE_NOC_LASTCHECK", JSON.stringify({
          ts: now.toISOString(),
          server: document.getElementById("nocServerDetail").textContent,
          sync:   document.getElementById("nocSyncDetail").textContent,
          feeds:  document.getElementById("nocFeedsDetail").textContent
        }));
      }catch(e){ /* storage full — non-critical */ }
    });
}

/* Boot: first check on load, then 60s cycle */
if(document.readyState === "loading"){
  document.addEventListener("DOMContentLoaded", nocRunChecks);
} else {
  nocRunChecks();
}
setInterval(nocRunChecks, NOC_CONFIG.intervalMs);
/* =============== END NOC HEALTH MONITOR =============== */
</script>
