/* ================= SOC MAIN STATUS SYNC — local mirror for Linux bridge ================= */
/* The browser writes only to the trusted local SICE service. The cloud API key
   remains in the Linux system service, never in browser storage or HTML. */
var SOC_MAIN_PUSH_ENDPOINT = '/api/soc-main/push';

function socMainMirrorArray(key){
  try{
    var value = JSON.parse(localStorage.getItem(key) || '[]');
    return Array.isArray(value) ? value : [];
  }catch(e){ return []; }
}

function pushSocMainStatus(incidentsRecent){
  try{
    fetch(SOC_MAIN_PUSH_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        updated_at: new Date().toISOString(),
        incidents: incidentsRecent || socMainMirrorArray('sice_so_incidents'),
        activity_log: socMainMirrorArray('sice_activity_log'),
        patrols: socMainMirrorArray('sice_so_patrols'),
        threats: socMainMirrorArray('sice_so_threats'),
        hazards: socMainMirrorArray('sice_hs_hazards'),
        inspections: socMainMirrorArray('sice_safety_inspections'),
        key_assets: socMainMirrorArray('sice_key_assets')
      }),
      cache: 'no-store'
    }).catch(function(){ /* server offline — silent, non-blocking */ });
  }catch(e){ /* no-op */ }
}

/* ================= TRAFFIC ALERTS — i-traffic.co.za, via sice_server.py proxy ================= */
var TRAFFIC_CACHE_KEY = 'sice_traffic_alerts_cache';
var TRAFFIC_ENDPOINT = 'http://localhost:8743/api/traffic-alerts';
var TRAFFIC_REFRESH_MS = 300000; // 5 min, matches server cache TTL

function fetchTrafficAlerts(){
  var statusEl = document.getElementById('jocTrafficStatus');
  var listEl = document.getElementById('jocTraffic');
  if(!statusEl || !listEl) return;

  statusEl.textContent = 'Fetching…';
  fetch(TRAFFIC_ENDPOINT, { cache: 'no-store' })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if(data.error){
        statusEl.textContent = 'Status: Unconfirmed — ' + data.error;
        renderTrafficAlerts([]);
        return;
      }
      try{ localStorage.setItem(TRAFFIC_CACHE_KEY, JSON.stringify(data)); }catch(e){}
      renderTrafficAlerts(data.alerts, data.fetched_at, false);
    })
    .catch(function(){
      var cached = null;
      try{ cached = JSON.parse(localStorage.getItem(TRAFFIC_CACHE_KEY)); }catch(e){}
      if(cached){
        renderTrafficAlerts(cached.alerts, cached.fetched_at, true);
      } else {
        statusEl.textContent = 'Status: Unconfirmed — local server unreachable.';
        renderTrafficAlerts([]);
      }
    });
}

function renderTrafficAlerts(alerts, fetchedAt, stale){
  var statusEl = document.getElementById('jocTrafficStatus');
  var listEl = document.getElementById('jocTraffic');
  var stamp = fetchedAt ? new Date(fetchedAt * 1000).toLocaleTimeString('en-ZA', { hour12:false }) + ' SAST' : '—';

  if(!alerts || alerts.length === 0){
    statusEl.textContent = 'Negative. No traffic alerts logged for AO. Last check: ' + stamp + (stale ? ' [STALE]' : '');
    listEl.innerHTML = '<div class="joc-empty">Negative. No data logged for AO.</div>';
    return;
  }

  statusEl.textContent = alerts.length + ' alert(s) — last check: ' + stamp + (stale ? ' [STALE — server unreachable]' : '');
  listEl.innerHTML = alerts.map(function(a){
    return '<div class="joc-inc-item">' +
      '<span class="ref">' + (a.id||'—') + '</span>' +
      '<span style="flex:1">' + (a.message||'—') + '</span>' +
      (a.notes ? '<span>' + a.notes + '</span>' : '') +
      (a.areas && a.areas.length ? '<span style="color:var(--t3);">' + a.areas.join(', ') + '</span>' : '') +
      '</div>';
  }).join('');
}

