function autoOpenIfRed(){
  let openHazards = 0, flagged24h = 0;
  try{
    const hz = JSON.parse(localStorage.getItem('sice_hs_hazards')) || [];
    openHazards = hz.filter(h => h.status !== 'closed').length;
  }catch(e){}
  try{
    const log = JSON.parse(localStorage.getItem('sice_activity_log')) || [];
    const cutoff = Date.now() - 24*60*60*1000;
    flagged24h = log.filter(e => (e.type === 'fail' || e.type === 'incident') && new Date(e.ts).getTime() >= cutoff).length;
  }catch(e){}

  if(openHazards > 0 || flagged24h > 0){
    const actPanel = document.getElementById('actFeedPanel');
    const actBtn = document.getElementById('actFeedToggleBtn');
    if(actPanel && !actPanel.classList.contains('open')){
      actPanel.classList.add('open');
      actBtn.classList.add('open');
      renderActFeed();
    }
  }

  let expiringCount = 0;
  try{ expiringCount = collectExpiryItems().length; }catch(e){}
  if(expiringCount > 0){
    const expPanel = document.getElementById('expiryPanel');
    const expBtn = document.getElementById('expiryToggleBtn');
    if(expPanel && !expPanel.classList.contains('open')){
      expPanel.classList.add('open');
      expBtn.classList.add('open');
      renderExpiryWatchlist();
    }
  }
}

function renderActFeed(){
  let log = [];
  try{ log = JSON.parse(localStorage.getItem('sice_activity_log')) || []; }catch(e){ log = []; }

  const modulesPresent = Array.from(new Set(log.map(e=>e.module)));
  const filterBox = document.getElementById('actFeedFilters');
  filterBox.innerHTML = modulesPresent.map(m => `
    <button onclick="setActFeedFilter('${m}')"
      style="font-size:10.5px;padding:4px 9px;border-radius:20px;cursor:pointer;
             border:1px solid var(--glass-edge);
             background:${actFeedFilter===m ? 'var(--accent)' : 'transparent'};
             color:${actFeedFilter===m ? '#0a1a10' : 'var(--t2)'};">
      ${ACTFEED_MODULE_LABELS[m] || m}
    </button>
  `).join('');

  const cutoff = Date.now() - 24*60*60*1000;
  let filtered = log.filter(e => new Date(e.ts).getTime() >= cutoff);
  if(actFeedFilter) filtered = filtered.filter(e => e.module === actFeedFilter);
  filtered = filtered.slice(0, 20);

  const box = document.getElementById('actFeedList');
  if(!filtered.length){
    box.innerHTML = '<div class="joc-empty">Negative. No data logged in last 24hrs.</div>';
    return;
  }
  box.innerHTML = filtered.map(e => {
    const d = new Date(e.ts);
    const time = d.toLocaleString('en-ZA', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
    const isFail = (e.type === 'fail' || e.type === 'incident');
    return `
      <div class="joc-contact" style="align-items:flex-start;${isFail ? 'border-left:3px solid var(--danger,#dc2626);padding-left:8px;' : ''}">
        <span style="max-width:75%;">
          <b style="font-size:10px;color:var(--t3);display:block;text-transform:uppercase;letter-spacing:0.4px;">
            ${ACTFEED_MODULE_LABELS[e.module] || e.module} · ${e.actor || 'Unknown'}
          </b>
          ${e.summary}
        </span>
        <b style="font-size:10px;white-space:nowrap;">${time}</b>
      </div>`;
  }).join('');
}

