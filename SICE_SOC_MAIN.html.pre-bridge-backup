/* ================= CAROUSEL — 3D cube/coverflow swipe ================= */
var carouselCards = [];
var carouselIndex = 0; // index of the centered card on boot

function initCarousel(){
  var track = document.getElementById('carouselTrack');
  if(!track) return;
  carouselCards = Array.prototype.slice.call(track.querySelectorAll('.option-card'));
  carouselIndex = 0;

  // Only the centered card has pointer-events enabled (see renderCarousel),
  // but we double-check is-center here too as a hard guard — this card can
  // never open unless it is unambiguously the one on screen-front.
  carouselCards.forEach(function(card){
    card.addEventListener('click', function(){
      if(!card.classList.contains('is-center')) return;
      var file = card.getAttribute('data-file');
      var label = card.getAttribute('data-label');
      if(file) openApp(file, label);
    });
  });

  var vp = document.getElementById('carouselViewport');
  if(vp){
    // Touch swipe only (mouse-drag removed — it raced with native click events
    // and could fire an extra step right before the click handler ran, landing
    // on the wrong card). Desktop users browse via arrow keys / nav buttons.
    var touchStartX = null, touchDeltaX = 0;
    vp.addEventListener('touchstart', function(e){
      touchStartX = e.touches[0].clientX; touchDeltaX = 0;
    }, {passive:true});
    vp.addEventListener('touchmove', function(e){
      if(touchStartX === null) return;
      touchDeltaX = e.touches[0].clientX - touchStartX;
    }, {passive:true});
    vp.addEventListener('touchend', function(){
      if(touchStartX === null) return;
      if(touchDeltaX > 40) carouselStep(-1);
      else if(touchDeltaX < -40) carouselStep(1);
      touchStartX = null; touchDeltaX = 0;
    });
  }

  renderCarousel();
}

function renderCarousel(){
  var n = carouselCards.length;
  carouselCards.forEach(function(card, i){
    var offset = i - carouselIndex;
    // wrap to shortest visual distance so the ring feels continuous
    if(offset > n/2) offset -= n;
    if(offset < -n/2) offset += n;

    var angle = offset * 26;      // degrees of cube-style rotation per step
    var spacing = 300;             // px horizontal spacing between card centers
    var depth = -Math.abs(offset) * 110; // pushes side cards back in Z for a cube feel

    card.classList.toggle('is-center', offset === 0);

    if(Math.abs(offset) > 2){
      card.style.opacity = '0';
      card.style.pointerEvents = 'none';
      card.style.transform = 'translateX(' + (offset*spacing) + 'px) translateZ(' + depth + 'px) rotateY(' + angle + 'deg) scale(.7)';
      card.style.zIndex = 0;
      return;
    }
    var opacity = offset === 0 ? 1 : (Math.abs(offset) === 1 ? 0.55 : 0.22);
    var scale = offset === 0 ? 1 : (Math.abs(offset) === 1 ? 0.86 : 0.72);
    card.style.opacity = String(opacity);
    // Only the truly centered card can receive clicks — side cards are visible
    // but inert, so a click can never land on the wrong app because of a
    // rotateY/translateZ stacking quirk. Swipe / arrows / nav buttons bring a
    // side card to center; only then does it become clickable.
    card.style.pointerEvents = (offset === 0) ? 'auto' : 'none';
    card.style.zIndex = String(100 - Math.abs(offset));
    card.style.transform = 'translateX(' + (offset*spacing) + 'px) translateZ(' + depth + 'px) rotateY(' + angle + 'deg) scale(' + scale + ')';
  });
}

function carouselStep(dir){
  if(!carouselCards.length) return;
  carouselIndex = (carouselIndex + dir + carouselCards.length) % carouselCards.length;
  renderCarousel();
}

document.addEventListener('keydown', function(e){
