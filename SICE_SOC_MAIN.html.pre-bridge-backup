function renderStatusStrip(){
  const strip = document.getElementById('statusStrip');
  if(!strip) return;

  let openHazards = 0;
  try{
    const hz = JSON.parse(localStorage.getItem('sice_hs_hazards')) || [];
    openHazards = hz.filter(h => h.status !== 'closed').length;
  }catch(e){}

  let keysOut = 0;
  try{
    const assets = JSON.parse(localStorage.getItem('sice_key_assets')) || [];
    keysOut = assets.filter(a => a.status === 'out').length;
  }catch(e){}

  let flagged24h = 0;
  let lastActivityTs = null;
  try{
    const log = JSON.parse(localStorage.getItem('sice_activity_log')) || [];
    const cutoff = Date.now() - 24*60*60*1000;
    flagged24h = log.filter(e => (e.type === 'fail' || e.type === 'incident') && new Date(e.ts).getTime() >= cutoff).length;
    if(log.length) lastActivityTs = log[0].ts;
  }catch(e){}

  let expiringCount = 0;
  try{
    expiringCount = collectExpiryItems().length;
  }catch(e){}

  const dot = c => `<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${c};margin-right:5px;"></span>`;
  const items = [];
  items.push(`<span style="color:${openHazards>0?'var(--danger,#e5484d)':'var(--accent)'};">${dot(openHazards>0?'var(--danger,#e5484d)':'var(--accent)')}Open Hazards: <b>${openHazards}</b></span>`);
  items.push(`<span style="color:${flagged24h>0?'var(--danger,#e5484d)':'var(--accent)'};">${dot(flagged24h>0?'var(--danger,#e5484d)':'var(--accent)')}Flagged (24h): <b>${flagged24h}</b></span>`);
  items.push(`<span style="color:${keysOut>0?'var(--warn,#e8b93f)':'var(--accent)'};">🔑 Keys Out: <b>${keysOut}</b></span>`);
  items.push(`<span style="color:${expiringCount>0?'var(--warn,#e8b93f)':'var(--accent)'};">⚠️ Expiring: <b>${expiringCount}</b></span>`);
  const lastTxt = lastActivityTs ? new Date(lastActivityTs).toLocaleString('en-ZA',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : 'No data logged';
  items.push(`<span style="color:var(--t3,#888);">🕒 Last Activity: ${lastTxt}</span>`);

  strip.innerHTML = items.join('<span style="color:var(--glass-edge);">|</span>');
}

function runStackSearch(qRaw){
  const box = document.getElementById('stackSearchResults');
  const q = (qRaw||'').trim().toLowerCase();
  if(q.length < 2){ box.style.display = 'none'; box.innerHTML = ''; return; }

  const results = [];

  try{
    const log = JSON.parse(localStorage.getItem('sice_activity_log')) || [];
    log.forEach(e => {
      if((e.summary||'').toLowerCase().includes(q) || (e.actor||'').toLowerCase().includes(q)){
        results.push({
          source: 'Activity', file: MODULE_FILE_MAP[e.module] || null, label: ACTFEED_MODULE_LABELS[e.module] || e.module,
          title: e.summary, ts: e.ts
        });
      }
    });
  }catch(ex){}

  try{
    const hz = JSON.parse(localStorage.getItem('sice_hs_hazards')) || [];
    hz.forEach(h => {
      if((h.desc||'').toLowerCase().includes(q) || (h.loc||'').toLowerCase().includes(q)){
        results.push({
          source: 'Hazard', file: 'SICE_HEALTH_SAFETY.html', label: '⛑️ Health & Safety',
          title: (h.status==='closed'?'[CLOSED] ':'[OPEN] ') + (h.desc||''), ts: h.reportedAt || h.createdAt || null
        });
      }
    });
  }catch(ex){}

  try{
    const assets = JSON.parse(localStorage.getItem('sice_key_assets')) || [];
    assets.forEach(a => {
      if((a.desc||'').toLowerCase().includes(q) || (a.id||'').toLowerCase().includes(q)){
        results.push({
          source: 'Asset', file: 'SICE_KEY_CONTROL.html', label: '🔑 Key Control',
          title: (a.desc||a.id) + ' — status: ' + (a.status||'unknown'), ts: null
        });
      }
    });
  }catch(ex){}

  results.sort((a,b) => (new Date(b.ts||0)) - (new Date(a.ts||0)));
  const top = results.slice(0, 25);

  if(!top.length){
    box.innerHTML = '<div style="padding:12px;font-size:11.5px;color:var(--t3,#888);">Negative. No matches across the stack.</div>';
  } else {
    box.innerHTML = top.map(r => {
      const d = r.ts ? new Date(r.ts).toLocaleString('en-ZA',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '';
      return `<div onclick="stackSearchJump('${r.file||''}','${(r.label||'').replace(/'/g,"\\'")}')"
        style="padding:9px 14px;border-bottom:1px solid var(--glass-edge);cursor:${r.file?'pointer':'default'};font-size:11.5px;">
        <span style="color:var(--t2);font-size:10px;text-transform:uppercase;letter-spacing:0.4px;">${r.source} · ${r.label}</span><br>
        ${r.title}
        ${d ? `<span style="float:right;color:var(--t3,#888);font-size:10px;">${d}</span>` : ''}
      </div>`;
    }).join('');
  }
  box.style.display = 'block';
}

function stackSearchJump(file, label){
  if(!file) return;
  document.getElementById('stackSearchResults').style.display = 'none';
  document.getElementById('stackSearchInput').value = '';
  openApp(file, label);
}

