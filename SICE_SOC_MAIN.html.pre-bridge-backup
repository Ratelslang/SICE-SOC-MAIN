<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#141710">
<link rel="manifest" href="./manifest.json">
<link rel="icon" href="./icon-192.png">
<link rel="apple-touch-icon" href="./icon-192.png">
<title>SICE SOC — Main Portal</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

:root{
  --bg-deep:#242427; --bg-mid:#2e2e32;
  --accent:#c4c8d0; --accent-dim:rgba(196,200,208,0.22); --accent-sub:rgba(196,200,208,0.12);
  --glass:rgba(42,42,45,0.72); --glass-hi:rgba(54,54,58,0.85);
  --glass-edge:rgba(255,255,255,0.14); --glass-hi-edge:rgba(255,255,255,0.32);
  --t1:#f2f1ec; --t2:#c7c9d1; --t3:#8b8f9c;
  --danger:#d9645a;
  --radius:12px; --radius-lg:18px; --radius-sm:8px;
  /* Chip palette — used sparingly for module/status variety so the dashboard
     doesn't read as a single flat hue. No blue, by design. */
  --chip-gold:#c4c8d0; --chip-gold-bg:rgba(196,200,208,0.14);
  --chip-emerald:#5fa87e; --chip-emerald-bg:rgba(95,168,126,0.14);
  --chip-rust:#c97a4a; --chip-rust-bg:rgba(201,122,74,0.14);
  --chip-violet:#9a80c4; --chip-violet-bg:rgba(154,128,196,0.14);
  --chip-rose:#c66b7a; --chip-rose-bg:rgba(198,107,122,0.14);
}
/* ===== NIGHT MODE — low-glare, red-dominant palette for night vision preservation ===== */
body.night-mode{
  --bg-deep:#000000; --bg-mid:#0a0000;
  --accent:#c23b32; --accent-dim:rgba(194,59,50,0.22); --accent-sub:rgba(194,59,50,0.1);
  --glass:rgba(20,4,4,0.65); --glass-hi:rgba(38,8,8,0.8);
  --glass-edge:rgba(194,59,50,0.3); --glass-hi-edge:rgba(220,90,80,0.45);
  --t1:#e8c4c0; --t2:#c08d87; --t3:#7a4a45;
  --danger:#ffc233;
}
body.night-mode #wallpaper{ opacity:0.25; filter:grayscale(1) sepia(1) hue-rotate(-40deg) saturate(3); }
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;font-family:'Inter',sans-serif;}
body{
  color:var(--t1); min-height:100vh; height:auto; overflow-y:auto; overflow-x:hidden;
  display:block; position:relative;
  background: radial-gradient(1200px 800px at 15% -10%, #38383c 0%, transparent 60%),
              linear-gradient(160deg, var(--bg-deep) 0%, var(--bg-mid) 60%, #1a1a1c 100%);
  padding:24px;
}
.page-center{width:100%;min-height:calc(100vh - 48px);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;z-index:2;}
.hidden{display:none!important;}

/* ---- LIVE WALLPAPER — restrained architectural grid, no illustrated globe/circuit board ---- */
#wallpaper{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none;opacity:0.4;}
.exec-grid{width:100%;height:100%;}
.exec-grid-lines{animation:execGridDrift 60s ease-in-out infinite;}
@keyframes execGridDrift{ 0%,100%{transform:translate(0,0);} 50%{transform:translate(-14px,10px);} }
@keyframes circuitFlow{ to{ stroke-dashoffset:-914; } }

/* Login */
.login-card{
  width:340px; background:var(--glass); border:1px solid var(--glass-edge);
  border-radius:var(--radius-lg); padding:32px 28px; backdrop-filter:blur(30px);
  box-shadow:0 20px 60px rgba(0,0,0,0.5);
}
.login-logo-row{display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:22px;}
.login-icon{font-size:36px;}
.login-title{font-size:16px;font-weight:800;letter-spacing:.5px;text-align:center;}
.login-sub{font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;text-align:center;}
.login-card input{
  width:100%; background:rgba(0,0,0,0.25); border:1px solid var(--glass-edge);
  color:var(--t1); padding:11px 13px; border-radius:var(--radius-sm); font-size:13px;
  margin-bottom:10px; font-family:inherit;
}
.login-card input:focus{outline:none;border-color:rgba(255,255,255,0.5);}
#login-error{color:var(--danger);font-size:11px;margin-bottom:8px;display:none;}
.btn{
  border:1px solid var(--glass-edge); background:var(--glass); color:var(--t1);
  padding:8px 14px; border-radius:var(--radius-sm); font-size:12px; font-weight:600;
  cursor:pointer; font-family:inherit;
}
.btn-accent{background:#f2f1ec;color:#1b1b1d;border-color:#f2f1ec;}
.btn-accent:hover{filter:brightness(1.08);}
.login-btn{width:100%;padding:12px;margin-top:6px;font-size:13px;}

/* Main selector */
#selector{width:100%;max-width:1100px;}
.sel-head{text-align:center;margin-bottom:8px;}
.sel-title{font-size:24px;font-weight:800;letter-spacing:.4px;}
.sel-sub{font-size:12px;color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;margin-top:6px;}
.sel-clock{text-align:center;font-size:11px;color:var(--t3);margin:14px 0 30px;font-family:'JetBrains Mono',monospace;}

/* ---- CAROUSEL — 3D cube/coverflow swipe, QR always centered on open ---- */
.carousel-wrap{position:relative;width:100%;max-width:1100px;padding:0 54px;}
.carousel-viewport{
  position:relative; height:440px; perspective:1700px; overflow:visible;
}
.carousel-track{position:relative;width:100%;height:100%;transform-style:preserve-3d;}

.carousel-nav-btn{
  position:absolute; top:50%; transform:translateY(-50%); z-index:20; width:42px; height:42px; border-radius:50%;
  background:var(--glass); border:1px solid var(--glass-edge); color:var(--t1); font-size:18px; cursor:pointer;
  backdrop-filter:blur(16px); display:flex; align-items:center; justify-content:center; transition:.2s;
}
.carousel-nav-btn:hover{background:var(--glass-hi); border-color:rgba(255,255,255,0.45); color:var(--t1);}
.carousel-nav-btn.left{left:0;}
.carousel-nav-btn.right{right:0;}
@media(max-width:760px){.carousel-nav-btn{display:none;} .carousel-wrap{padding:0 4px;}}

.option-card{
  background:var(--glass); border:1px solid var(--glass-edge); border-radius:var(--radius-lg);
  padding:38px 32px; cursor:default; text-decoration:none; color:var(--t1);
  transition:transform .6s cubic-bezier(.22,.9,.3,1), opacity .55s ease, filter .55s ease;
  display:flex; flex-direction:column; gap:16px; overflow:hidden;
  backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  position:absolute; top:0; left:50%; width:360px; height:410px; margin-left:-180px;
  box-shadow:0 10px 28px rgba(0,0,0,0.35); backface-visibility:hidden;
}
.option-card.is-center{cursor:pointer;}
.option-card::before{content:'';position:absolute;inset:0;background:linear-gradient(160deg, rgba(255,255,255,0.04), transparent 40%);pointer-events:none;}
.option-card.is-center{border-color:rgba(255,255,255,0.4); box-shadow:0 18px 44px rgba(0,0,0,0.5);}
.option-card.is-center:hover{background:var(--glass-hi);}
.option-icon{
  font-size:26px; width:56px; height:56px; display:flex; align-items:center; justify-content:center;
  border-radius:50%; background:var(--chip-color-bg, var(--accent-sub)); border:1px solid var(--chip-color-border, var(--glass-edge));
}
.option-name{font-size:21px;font-weight:800;letter-spacing:.3px;}
.option-desc{font-size:13px;color:var(--t2);line-height:1.65;min-height:88px;}
.option-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px;}
.option-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:5px 10px;border-radius:20px;background:rgba(255,255,255,0.06);color:var(--t2);border:1px solid var(--glass-edge);}
.option-go{margin-top:auto;font-size:12px;font-weight:700;color:var(--t1);text-transform:uppercase;letter-spacing:1px;}

/* Chip color variety — cycled across carousel tiles so the dashboard reads
   as a considered system, not one flat hue repeated 11 times. */
.chip-gold .option-icon{--chip-color-bg:var(--chip-gold-bg);--chip-color-border:rgba(196,200,208,0.35);}
.chip-emerald .option-icon{--chip-color-bg:var(--chip-emerald-bg);--chip-color-border:rgba(95,168,126,0.35);}
.chip-rust .option-icon{--chip-color-bg:var(--chip-rust-bg);--chip-color-border:rgba(201,122,74,0.35);}
.chip-violet .option-icon{--chip-color-bg:var(--chip-violet-bg);--chip-color-border:rgba(154,128,196,0.35);}
.chip-rose .option-icon{--chip-color-bg:var(--chip-rose-bg);--chip-color-border:rgba(198,107,122,0.35);}
.qr-card{align-items:center;text-align:center;}
.qr-card img{width:170px !important;height:170px !important;}

.foot{text-align:center;margin-top:26px;font-size:10.5px;color:var(--t3);}
.foot a{color:var(--t3);}

/* Embedded workspace — loads the other apps inline so SOC Main is the only file you ever open */
#workspace{display:none;width:100%;height:100vh;flex-direction:column;position:fixed;inset:0;z-index:500;background:var(--bg-deep);}
#workspace.active{display:flex;}
.ws-bar{
  height:52px; flex-shrink:0; display:flex; align-items:center; gap:14px; padding:0 16px;
  background:rgba(20,23,16,0.92); border-bottom:1px solid var(--glass-edge); backdrop-filter:blur(20px);
}
.ws-bar .ws-title{font-weight:800;font-size:13px;letter-spacing:.3px;}
.ws-bar .btn{margin-left:auto;}
#workspace iframe{flex:1;width:100%;border:none;background:#0a0d08;}
/* ---- NOC HEALTH ROW ---- */
.noc-row{
  display:flex; gap:10px; align-items:stretch;
  margin:10px 0 14px 0; padding:8px 10px;
  background:rgba(30,38,26,.55);
  border:1px solid rgba(120,140,90,.35);
  border-radius:8px;
  backdrop-filter:blur(6px);
  font-family:inherit;
}
.noc-tile{
  flex:1; min-width:0;
  display:flex; align-items:center; gap:8px;
  padding:7px 10px;
  background:rgba(18,24,16,.6);
  border:1px solid rgba(90,110,70,.3);
  border-radius:6px;
  font-size:.78rem; letter-spacing:.06em;
  color:#c9d2b8; text-transform:uppercase;
}
.noc-dot{
  width:11px; height:11px; border-radius:50%;
  flex:0 0 auto;
  background:#5a6151; /* grey = unchecked */
  box-shadow:0 0 6px rgba(0,0,0,.5);
  transition:background .3s, box-shadow .3s;
}
.noc-dot.up   { background:#6fbf4a; box-shadow:0 0 8px rgba(111,191,74,.7); }
.noc-dot.warn { background:#d9a23c; box-shadow:0 0 8px rgba(217,162,60,.7); }
.noc-dot.down { background:#c74436; box-shadow:0 0 8px rgba(199,68,54,.75);
                animation:nocPulse 1.2s infinite; }
@keyframes nocPulse{ 50%{ opacity:.45; } }
.noc-label{ font-weight:600; white-space:nowrap; }
.noc-detail{
  margin-left:auto; font-size:.68rem; color:#8a9478;
  text-transform:none; letter-spacing:.02em;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.noc-meta{
  flex:0 0 auto; display:flex; flex-direction:column;
  justify-content:center; align-items:flex-end; gap:3px;
  font-size:.65rem; color:#77816a; padding:0 4px;
}
.noc-refresh{
  cursor:pointer; color:#a8b58e; border:1px solid rgba(120,140,90,.4);
  border-radius:4px; padding:2px 8px; background:transparent;
  font-size:.65rem; letter-spacing:.08em; text-transform:uppercase;
}
.noc-refresh:hover{ background:rgba(120,140,90,.2); }
@media (max-width:640px){ .noc-row{ flex-wrap:wrap; } .noc-tile{ flex:1 1 45%; } }

/* ---- JOC PANEL (integrated tab inside SOC MAIN — not a standalone app) ---- */
.joc-toggle-row{margin:0 0 18px 0;}
.joc-toggle-btn{
  width:100%; text-align:left; cursor:pointer; background:var(--glass);
  border:1px solid var(--glass-edge); border-radius:var(--radius); padding:12px 16px;
  color:var(--t1); font-family:inherit; font-size:13px; font-weight:700;
  display:flex; align-items:center; gap:10px; letter-spacing:.3px;
}
.joc-toggle-btn:hover{border-color:rgba(255,255,255,0.4); background:var(--glass-hi);}
.joc-toggle-btn .arrow{margin-left:auto; font-size:11px; color:var(--t3); transition:.2s;}
.joc-toggle-btn.open .arrow{transform:rotate(180deg);}
.joc-panel{display:none; margin-top:10px; background:var(--glass); border:1px solid var(--glass-edge); border-radius:var(--radius-lg); padding:20px;}
.joc-panel.open{display:block;}
.joc-sub{font-size:10.5px; text-transform:uppercase; letter-spacing:1.2px; color:var(--t3); margin:14px 0 8px;}
.joc-sub:first-child{margin-top:0;}
.joc-contact{display:flex; justify-content:space-between; font-size:12.5px; color:var(--t2); padding:5px 0; border-bottom:1px dashed var(--glass-edge);}
.joc-contact b{color:var(--t1);}
.joc-inc-item{font-size:12px; color:var(--t2); padding:7px 9px; background:rgba(0,0,0,0.2); border-radius:var(--radius-sm); margin-bottom:6px; display:flex; gap:8px; flex-wrap:wrap;}
.joc-inc-item .ref{color:var(--t1); font-weight:700; font-family:'JetBrains Mono',monospace;}
.joc-empty{font-size:12px; color:var(--t3); font-style:italic;}
</style>
</head>
<body>
<script>if(localStorage.getItem('sice_theme_mode')==='night'){document.body.classList.add('night-mode');}</script>

<div id="wallpaper">
  <svg class="exec-grid" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="execFade" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.10"/>
        <stop offset="55%" stop-color="#ffffff" stop-opacity="0.02"/>
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <g class="exec-grid-lines">
      <!-- Restrained architectural grid — thin hairlines, no glow, no pulsing nodes.
           Slow single drift animation only; this replaces the illustrated globe/circuit board. -->
      <g stroke="url(#execFade)" stroke-width="1" fill="none">
        <path d="M0,60 L1000,60"/><path d="M0,140 L1000,140"/><path d="M0,220 L1000,220"/>
        <path d="M0,300 L1000,300"/><path d="M0,380 L1000,380"/><path d="M0,460 L1000,460"/>
        <path d="M0,540 L1000,540"/>
        <path d="M80,0 L80,600"/><path d="M220,0 L220,600"/><path d="M360,0 L360,600"/>
        <path d="M500,0 L500,600"/><path d="M640,0 L640,600"/><path d="M780,0 L780,600"/>
        <path d="M920,0 L920,600"/>
      </g>
    </g>
    <circle class="exec-glow" cx="120" cy="80" r="260" fill="#ffffff" opacity="0.035"/>
  </svg>
</div>

<div class="page-center">
<div id="login-screen">
  <div class="login-card">
    <div class="login-logo-row">
      <div class="login-icon">🎖️</div>
      <div class="login-title">SICE SOC — MAIN PORTAL</div>
      <div class="login-sub">Sinoville Integrated Security Initiative</div>
    </div>
    <input type="text" id="login-user" placeholder="Username" autocomplete="username">
    <input type="password" id="login-pass" placeholder="Password" autocomplete="current-password">
    <div id="login-error">Invalid credentials.</div>
    <button class="btn btn-accent login-btn" onclick="doLogin()">Enter SOC</button>
  </div>
</div>

<div id="selector" class="hidden">
  <div class="sel-head">
    <div class="sel-title">🎖️ SICE SOC — MAIN PORTAL</div>
    <div class="sel-sub" id="user-label">—</div>
  </div>
  <button id="nightModeToggle" onclick="toggleNightMode()" style="position:fixed;top:14px;right:14px;z-index:200;background:var(--glass);border:1px solid var(--glass-edge);color:var(--t1);padding:8px 12px;border-radius:20px;cursor:pointer;font-size:12px;">🌙 Night Mode</button>
  <button id="pwaInstallBtn" onclick="triggerPwaInstall()" style="display:none;position:fixed;top:14px;right:150px;z-index:200;background:var(--glass);border:1px solid var(--glass-edge);color:var(--t1);padding:8px 12px;border-radius:20px;cursor:pointer;font-size:12px;">📲 Install App</button>
  <div class="sel-clock" id="clock">—</div>
<div class="noc-row" id="nocRow">
  <div class="noc-tile" id="nocServer">
    <span class="noc-dot" id="nocServerDot"></span>
    <span class="noc-label">Server</span>
    <span class="noc-detail" id="nocServerDetail">—</span>
  </div>
  <div class="noc-tile" id="nocSync">
    <span class="noc-dot" id="nocSyncDot"></span>
    <span class="noc-label">Sync</span>
    <span class="noc-detail" id="nocSyncDetail">—</span>
  </div>
  <div class="noc-tile" id="nocFeeds">
    <span class="noc-dot" id="nocFeedsDot"></span>
    <span class="noc-label">Feeds</span>
    <span class="noc-detail" id="nocFeedsDetail">—</span>
  </div>
  <div class="noc-meta">
    <span id="nocLastCheck">Last check: —</span>
    <button class="noc-refresh" onclick="nocRunChecks()">Recheck</button>
  </div>
</div>

<div id="stackSearchWrap" style="margin:0 0 12px;position:relative;">
  <input type="text" id="stackSearchInput" placeholder="🔎 Search across the whole stack — assets, hazards, keys, activity…" oninput="runStackSearch(this.value)"
    style="width:100%;padding:10px 14px;border-radius:8px;background:var(--glass);border:1px solid var(--glass-edge);color:var(--t1,#eee);font-family:inherit;font-size:12.5px;">
  <div id="stackSearchResults" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--glass);border:1px solid var(--glass-edge);border-radius:8px;max-height:340px;overflow-y:auto;z-index:50;"></div>
</div>

<div id="statusStrip" style="display:flex;flex-wrap:wrap;gap:10px;padding:10px 14px;margin:0 0 14px;background:var(--glass);border:1px solid var(--glass-edge);border-radius:8px;font-size:11.5px;">
  <!-- populated by renderStatusStrip() -->
</div>

<div id="quickActionRow" style="display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px;">
  <button class="btn" onclick="openApp('SICE_WAR_ROOM.html','🎖️ SICE War Room')">🎖️ Open War Room</button>
  <button class="btn" onclick="openApp('SICE_KEY_CONTROL.html','🔑 Key Control')">🔑 Issue/Return Key</button>
  <button class="btn" onclick="openApp('SICE_HEALTH_SAFETY.html','⛑️ Health &amp; Safety')">⛑️ Log Incident</button>
  <button class="btn" onclick="openApp('SICE_MOVEMENT_LOG.html','🚗 Movement Log')">🚗 Log Movement</button>
</div>
<div id="shortcutLegend" style="font-size:10px;color:var(--t3);margin:0 0 18px;letter-spacing:0.3px;">
  ⌨️ Shortcuts: <b>1</b> OPS · <b>2</b> Key Control · <b>3</b> Health &amp; Safety · <b>4</b> Recon · <b>5</b> Movement Log · <b>6</b> Incident Dashboard · <b>7</b> Intel Hub · <b>8</b> Fleet &amp; Movement · <b>9</b> Notebook · <b>20</b> War Room
</div>

  <div class="joc-toggle-row">
    <button class="joc-toggle-btn" id="jocToggleBtn" onclick="toggleJOC()">
      🚨 JOC — Joint Operations Centre <span class="arrow">▼</span>
    </button>
    <div class="joc-panel" id="jocPanel">
      <div class="joc-sub">☎ Escalation Contacts</div>
      <div class="joc-contact"><span>SAPS Sinoville</span><b>012 543 8831</b></div>
      <div class="joc-contact"><span>CPF Sector 1</span><b>071 509 6830</b></div>
      <div class="joc-contact"><span>CPF Sector 2</span><b>079 025 5001</b></div>
      <div class="joc-contact"><span>SAPS Emergency</span><b>10111 / 112</b></div>
      <div class="joc-contact"><span>Crime Stop</span><b>08600 10111</b></div>

      <div class="joc-sub">🗒️ Live Incident Feed — Last 24h (source: OPS / Intel Hub, shared log)</div>
      <div id="jocIncidents"><div class="joc-empty">Negative. No data logged in last 24hrs.</div></div>

      <div class="joc-sub">🚧 Road &amp; Infrastructure — Live Traffic Alerts (source: i-traffic.co.za)</div>
      <div id="jocTrafficStatus" style="font-size:10.5px;color:var(--t3);margin-bottom:6px;">—</div>
      <div id="jocTraffic"><div class="joc-empty">Negative. No traffic alerts logged for AO.</div></div>
    </div>
  </div>

  <div class="joc-toggle-row">
    <button class="joc-toggle-btn" id="actFeedToggleBtn" onclick="toggleActFeed()">
      🗒️ Activity Feed — Cross-Module <span class="arrow">▼</span>
    </button>
    <div class="joc-panel" id="actFeedPanel">
      <div class="joc-sub">🗒️ Live Activity — Last 20 events (all modules, shared log)</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;" id="actFeedFilters"></div>
      <div id="actFeedList"><div class="joc-empty">Negative. No data logged in last 24hrs.</div></div>
    </div>
  </div>

  <div class="joc-toggle-row">
    <button class="joc-toggle-btn" id="expiryToggleBtn" onclick="toggleExpiryWatchlist()">
      ⚠️ Expiry Watchlist — Consolidated <span class="arrow">▼</span>
    </button>
    <div class="joc-panel" id="expiryPanel">
      <div class="joc-sub">⚠️ License Disks, Insurance &amp; PSIRA — expired or due within 30 days</div>
      <div id="expiryList"><div class="joc-empty">Negative. Nothing due in the next 30 days.</div></div>
    </div>
  </div>

  <div class="carousel-wrap">
