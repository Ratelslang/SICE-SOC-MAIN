/* Key 20 is entered as a short 2 → 0 sequence. The 2 shortcut remains intact:
   if 0 is not pressed within 700 ms, Key Control opens normally. */
const SEQUENCE_SHORTCUTS = {
  '20': { file: 'SICE_WAR_ROOM.html', label: '🎖️ SICE War Room' }
};
let shortcutSequence = '';
let shortcutSequenceTimer = null;
document.addEventListener('keydown', handleShortcutKey);

function executeShortcut(bind){
  if(!bind) return;
  if(document.getElementById('workspace').classList.contains('active')) closeApp();
  openApp(bind.file, bind.label);
}

function clearShortcutSequence(){
  if(shortcutSequenceTimer) clearTimeout(shortcutSequenceTimer);
  shortcutSequenceTimer = null;
  shortcutSequence = '';
}

function handleShortcutKey(e){
  if(!shortcutsActive) return;
  const tag = (e.target && e.target.tagName || '').toUpperCase();
  if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (e.target && e.target.isContentEditable)) return;

  if(e.key === '2'){
    e.preventDefault();
    clearShortcutSequence();
    shortcutSequence = '2';
    shortcutSequenceTimer = setTimeout(function(){
      if(shortcutSequence === '2'){
        clearShortcutSequence();
        executeShortcut(NUM_SHORTCUTS['2']);
      }
    }, 700);
    return;
  }

  if(shortcutSequence === '2' && e.key === '0'){
    e.preventDefault();
    clearShortcutSequence();
    executeShortcut(SEQUENCE_SHORTCUTS['20']);
    return;
  }

  if(shortcutSequence === '2'){
    clearShortcutSequence();
    executeShortcut(NUM_SHORTCUTS['2']);
  }

  const bind = NUM_SHORTCUTS[e.key];
  if(bind){
    e.preventDefault();
    executeShortcut(bind);
    return;
  }
  if(e.key === 'Escape' && document.getElementById('workspace').classList.contains('active')){
    clearShortcutSequence();
    closeApp();
  }
}

// Keys pressed while a module is open in the workspace land in the iframe's
// own document — a separate browsing context that never bubbles up to the
// parent page. Same-origin, so we can reach in and bind the same handler
// each time a module loads, or the shortcut silently does nothing once
// you're inside a module.
document.getElementById('ws-frame').addEventListener('load', function(){
  try{
    const idoc = this.contentDocument;
    if(idoc) idoc.addEventListener('keydown', handleShortcutKey);
  }catch(e){ /* cross-origin — nothing we can do, same-origin modules unaffected */ }
});

