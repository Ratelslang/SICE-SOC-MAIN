/* Pulls expiry-dated items from every module that has one, across the shared
   localStorage origin — OPS_ Client Vehicles, Fleet & Movement's Vehicle
   Register, and Personal's PSIRA registration. Anything expired or due
   within 30 days shows up here, sorted most-urgent first. */
function collectExpiryItems(){
  const items = [];
  const today = new Date(); today.setHours(0,0,0,0);
  function status(dateStr){
    if(!dateStr) return null;
    const exp = new Date(dateStr + 'T00:00:00');
    if(isNaN(exp.getTime())) return null;
    const days = Math.round((exp.getTime() - today.getTime()) / 86400000);
    return { days: days, label: days < 0 ? ('Expired ' + Math.abs(days) + 'd ago') : (days + 'd left') };
  }

  try{
    const vehicles = JSON.parse(localStorage.getItem('sice_vehicles')) || [];
    vehicles.forEach(v => {
      [['licenseExpiry','License Disk'], ['insuranceExpiry','Insurance']].forEach(([field,label]) => {
        const st = status(v[field]);
        if(st) items.push({ source: 'OPS Client Vehicles', file: 'OPS_.html', icon: '🚗',
          title: (v.plate || 'Vehicle') + ' — ' + label + ' (' + (v.owner||'—') + ')', days: st.days, label: st.label });
      });
    });
  }catch(e){}

  try{
    const fleet = JSON.parse(localStorage.getItem('sice_fleet_vehicles')) || [];
    fleet.forEach(v => {
      const st = status(v.expiry);
      if(st) items.push({ source: 'Fleet & Movement', file: 'SICE_FLEET_MOVEMENT.html', icon: '🚗',
        title: (v.plate || 'Vehicle') + ' — License Disk (' + (v.owner||'—') + ')', days: st.days, label: st.label });
    });
  }catch(e){}

  try{
    const personal = JSON.parse(localStorage.getItem('sice_personal_info')) || {};
    const st = status(personal.pPsiraExpiry);
    if(st) items.push({ source: 'Personal', file: 'SICE_PERSONAL.html', icon: '🛡️',
      title: 'PSIRA Registration Renewal', days: st.days, label: st.label });
  }catch(e){}

  return items.filter(i => i.days <= 30).sort((a,b) => a.days - b.days);
}

function renderExpiryWatchlist(){
  const box = document.getElementById('expiryList');
  if(!box) return;
  const items = collectExpiryItems();
  if(!items.length){
    box.innerHTML = '<div class="joc-empty">Negative. Nothing due in the next 30 days.</div>';
    return;
  }
  box.innerHTML = items.map(i => {
    const isExpired = i.days < 0;
    return `
      <div class="joc-contact" style="align-items:flex-start;cursor:pointer;${isExpired ? 'border-left:3px solid var(--danger,#dc2626);padding-left:8px;' : 'border-left:3px solid var(--warn,#e8b93f);padding-left:8px;'}" onclick="openApp('${i.file}','${i.icon} ${i.source}')">
        <span style="max-width:75%;">
          <b style="font-size:10px;color:var(--t3);display:block;text-transform:uppercase;letter-spacing:0.4px;">${i.icon} ${i.source}</b>
          ${i.title}
        </span>
        <b style="font-size:10px;white-space:nowrap;color:${isExpired ? 'var(--danger,#e5484d)' : 'var(--warn,#e8b93f)'};">${i.label}</b>
      </div>`;
  }).join('');
}

